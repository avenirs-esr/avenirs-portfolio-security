<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        Test-only entry point used by the permission catalog migration tests: provisions
        just the "permission" table (see schema-only-test-changelog.xml) and then runs the
        REAL production changelogs under db/changelog/data unmodified, so the actual
        changesets shipped with this task are what gets exercised.
    -->
    <include file="db/changelog/schema-only-test-changelog.xml" relativeToChangelogFile="false"/>
    <includeAll path="db/changelog/data" relativeToChangelogFile="false"/>
</databaseChangeLog>
