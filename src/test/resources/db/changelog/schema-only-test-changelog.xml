<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        Test-only, portable equivalent of the "permission" table created by the real
        Hibernate-diff generated changelogs (db/changelog/generated). The real generated
        changelogs cannot run against H2: they declare an unrelated column
        (action_route.method) with the PostgreSQL-only "citext" type, which H2 does not
        support even in PostgreSQL compatibility mode. Since this project has no
        Testcontainers/real-Postgres test setup, migration tests for the permission
        catalog provision just the table they actually need, matching RBACPermissionEntity
        exactly (id/name/description, unique name).
    -->
    <changeSet id="test-schema-permission-table" author="nathp">
        <createTable tableName="permission">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(80)">
                <constraints nullable="false" unique="true" uniqueConstraintName="permission_name_unique"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
