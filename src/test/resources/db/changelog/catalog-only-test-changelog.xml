<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        Test-only entry point running ONLY the real production data changelogs
        (db/changelog/data), without any schema-creation changeset. Used by tests that
        provision the "permission" table themselves via plain JDBC first (to simulate a
        database that already has manually-seeded rows), then apply the catalog changelogs
        as a single, first-ever Liquibase run against that connection.
    -->
    <includeAll path="db/changelog/data" relativeToChangelogFile="false"/>
</databaseChangeLog>
